{
  "name": "mobile-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --open",
    "build": "ng build",
    "ionic:serve": "ionic serve",
    "build:web": "ng build --configuration production --output-path=www",
    "cap:init": "npx cap init mobile-app com.example.mobileapp --web-dir=www",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@angular/common": "^16.0.0",
    "@angular/core": "^16.0.0",
    "@angular/forms": "^16.0.0",
    "@angular/router": "^16.0.0",
    "@ionic/angular": "^7.0.0",
    "ionicons": "^7.0.0",
    "@capacitor/core": "^5.0.0"
  },
  "devDependencies": {
    "@angular/cli": "^16.0.0",
    "typescript": "~5.1.3",
    "@capacitor/cli": "^5.0.0"
  }
}
